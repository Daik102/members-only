  <dialog id="delete-dialog" class="modal">
    <h3>Confirm Deletion</h3>
    <p>Are you sure you want to delete <strong id="delete-post-title"></strong>? This action cannot be undone.</p>

    <form id="delete-form" method="POST" class="modal-actions">
      <button type="button" id="cancel-delete" class="btn">Cancel</button>
      <button type="submit" class="btn btn-danger">Yes, Delete</button>
    </form>
  </dialog>

  <footer class="site-footer">
    Clubhouse Auth Demo &mdash; Render + Neon + Express
  </footer>

  <script>
    const deleteDialog = document.getElementById('delete-dialog');
    const deleteForm = document.getElementById('delete-form');
    const deletePostTitle = document.getElementById('delete-post-title');
    const cancelDeleteBtn = document.getElementById('cancel-delete');

    document.querySelectorAll('.delete-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const postId = btn.dataset.postId;
        const postTitle = btn.dataset.postTitle;

        deletePostTitle.textContent = `"${postTitle}"`;
        deleteForm.action = `/posts/${postId}/delete`;
        deleteDialog.showModal();
      });
    });

    cancelDeleteBtn.addEventListener('click', () => {
      deleteDialog.close();
    });

    // Close when clicking outside the dialog box on the backdrop
    deleteDialog.addEventListener('click', (e) => {
      if (e.target === deleteDialog) {
        deleteDialog.close();
      }
    });
  </script>
</body>
</html>
