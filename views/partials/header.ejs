<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Secret Clubhouse</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <nav class="navbar">
    <a href="/" class="brand">Secret Clubhouse</a>
    <div class="nav-links">
      <% if (currentUser) { %>
        <span>
          Hi, <span class="username"><%= currentUser.username %></span>
          <% if (currentUser.is_admin) { %>
            <span class="badge">ADMIN</span>
          <% } else if (currentUser.is_member) { %>
            <span class="badge">MEMBER</span>
          <% } %>
        </span>
        <% if (!currentUser.is_member && !currentUser.is_admin) { %>
          <a href="/join" class="btn">Join Club</a>
        <% } %>
        <% if (currentUser.is_admin) { %>
          <a href="/admin" class="btn">Dashboard</a>
        <% } else { %>
          <a href="/admin-join" class="btn">Admin</a>
        <% } %>
        <form action="/logout" method="POST" class="inline-form">
          <button type="submit" class="btn">Log Out</button>
        </form>
      <% } else { %>
        <a href="/login" class="btn">Log In</a>
        <a href="/signup" class="btn btn-primary">Sign Up</a>
      <% } %>
    </div>
  </nav>

  <% if (error) { %>
    <div class="alert"><%= error %></div>
  <% } %>
