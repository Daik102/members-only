<%- include('partials/header') %>

<div class="feed-header">
  <h2>Become an Admin</h2>
  <a href="/" class="btn">Back to Feed</a>
</div>
<p class="guest-notice">Enter the admin passcode to unlock full privileges (delete any post, view all authors and dates).</p>

<% if (errors && errors.length > 0) { %>
  <div class="alert">
    <ul>
      <% errors.forEach(err => { %>
        <li><%= err.msg %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<form action="/admin-join" method="POST">
  <div class="form-group">
    <label for="passcode">Admin Passcode</label>
    <input id="passcode" type="password" name="passcode" required />
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Unlock</button>
  </div>
</form>

<p class="passcode-container">Passcode: masterkey123</p>

<%- include('partials/footer') %>
