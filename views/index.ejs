<%- include('partials/header') %>

<div class="feed-header">
  <h2>Clubhouse Feed</h2>

  <% if (currentUser) { %>
    <a href="/posts/new" class="btn btn-primary">+ New Post</a>
  <% } %>
</div>

<% if (!currentUser) { %>
  <p class="guest-notice">
    <a href="/login">Log in</a> or <a href="/signup">sign up</a> to post messages and reveal who wrote each post!
  </p>
<% } %>

<% if (posts.length === 0) { %>
  <p>No posts yet.</p>
<% } %>

<% posts.forEach(post => { %>
  <article class="card">
    <h3><%= post.title %></h3>
    <p><%= post.content %></p>

    <div class="meta">
      Posted by:
      <span class="author-name"><%= currentUser ? post.author : 'Anonymous (Log in to reveal)' %></span>
      &bull; <%= new Date(post.created_at).toLocaleDateString() %>
    </div>

    <% if (currentUser && (currentUser.id === post.user_id || currentUser.is_admin)) { %>
      <div class="card-actions">
        <button
          type="button"
          class="btn btn-danger delete-btn"
          data-post-id="<%= post.id %>"
          data-post-title="<%= post.title %>"
        >
          Delete Post
        </button>
      </div>
    <% } %>
  </article>
<% }) %>

<%- include('partials/footer') %>
