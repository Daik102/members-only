<%- include('partials/header') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
  <h2 style="margin: 0;">Clubhouse Feed</h2>

  <% if (currentUser) { %>
    <a href="/posts/new" style="background: #1e293b; color: #fff; padding: 0.5rem 1rem; border-radius: 4px; text-decoration: none;">
      + New Post
    </a>
  <% } %>
</div>

<% if (!currentUser) { %>
  <p><em><a href="/login">Log in</a> or <a href="/signup">sign up</a> to post messages and reveal who wrote each post!</em></p>
<% } %>

<% if (posts.length === 0) { %>
  <p>No posts yet.</p>
<% } %>

<% posts.forEach(post => { %>
  <article class="card">
    <h3><%= post.title %></h3>
    <p><%= post.content %></p>

    <div class="meta">
      Posted by: 
      <strong><%= currentUser ? post.author : 'Anonymous (Log in to reveal)' %></strong>
      &bull; <%= new Date(post.created_at).toLocaleDateString() %>
    </div>

    <% if (currentUser && (currentUser.id === post.user_id || currentUser.is_admin)) { %>
      <div style="margin-top: 0.75rem;">
        <button
          type="button"
          class="delete-btn"
          data-post-id="<%= post.id %>"
          data-post-title="<%= post.title %>"
        >
          Delete Post
        </button>
      </div>
    <% } %>
  </article>
<% }) %>

<%- include('partials/footer') %>
