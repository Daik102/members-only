<%- include('partials/header', { title }) %>

<div class="feed-header">
  <h2>Hideout Feed</h2>

  <% if (currentUser) { %>
    <a href="/posts/new" class="btn btn-primary">+ New Post</a>
  <% } %>
</div>

<% const canSeeDetails = currentUser && (currentUser.is_member || currentUser.is_admin); %>

<% if (!currentUser) { %>
  <p class="guest-notice">
    <a href="/login">Log in</a> or <a href="/signup">sign up</a> to post messages.
  </p>
<% } else if (!canSeeDetails) { %>
  <p class="guest-notice">
    You are logged in as a guest. <a href="/join">Enter the passcode</a> to reveal authors and dates.
  </p>
<% } %>

<% posts.forEach(post => { %>
  <article class="card">
    <div class="card-title-row">
      <h3><%= post.title %></h3>
      <% if (currentUser && (currentUser.id === post.user_id || currentUser.is_admin)) { %>
        <button
          type="button"
          class="delete-btn btn-delete"
          data-post-id="<%= post.id %>"
          data-post-title="<%= post.title %>"
        >
          X
        </button>
      <% } %>
    </div>
    <p><%= post.content %></p>

    <div class="meta">
      Posted by:
      <span class="author-name"><%= canSeeDetails ? post.author : 'Anonymous' %></span>
      &nbsp;
      <%= canSeeDetails ? new Date(post.created_at).toLocaleDateString() : '**/**/****' %>
    </div>
  </article>
<% }) %>

<%- include('partials/footer') %>
